# Environment files (NEVER commit actual credentials)
.env
.env.local
.env.production

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
error_log
access_log

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Cache
cache/
*.cache

# Test files
test_report.txt
phpunit.xml

# Backup files
*.bak
*.backup
*~

# Node modules (if using npm)
node_modules/

# Composer
vendor/
composer.lock

# Uploaded files (keep structure, ignore content)
uploads/*
!uploads/.gitkeep

# Session files
sessions/

# Sensitive files (keep template only)
ca-certificate.crt.example
